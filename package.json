{
  "name": "avelor-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral, open-source commerce platform with AI-powered discovery",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,storefront\" -c \"cyan,magenta\" \"bun run dev:api\" \"bun run dev:storefront\"",
    "dev:all": "docker compose up -d postgres redis && bun run dev",
    "dev:api": "bun --filter @avelor/api dev",
    "dev:storefront": "bun --filter storefront dev",
    "start": "bun --filter @avelor/api start",
    "docker:db": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "db:push": "bun --filter @avelor/database db:push",
    "test": "bun test",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@types/bun": "1.4.3",
    "concurrently": "10.0.6",
    "typescript": "^5.7.3"
  }
}
