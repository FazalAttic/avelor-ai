{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avelor-cdn",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "routes": [
    {
      "pattern": "cdn.avelor-ai.cyou",
      "custom_domain": true
    }
  ],
  "vars": {
    "IMAGEKIT_ENDPOINT": "https://ik.imagekit.io/mqz7lr6zf",
    "BRAND_NAME": "Avelor AI CDN",
    "ICON_URL": "https://cdn.avelor-ai.cyou/icon.svg"
  }
}
