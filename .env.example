# Avelor AI - Environment Configuration Example
# Copy this file to .env and replace placeholders with actual values.

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgres://avelor:avelor@localhost:5432/avelor_dev

# AI Provider Configuration (optional for minimal local dev)
AI_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding Provider Configuration (optional)
EMBEDDING_PROVIDER=none

# Payment Provider Configuration (optional)
PAYMENT_PROVIDER=mock
