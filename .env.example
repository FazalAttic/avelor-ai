# ==============================================================================
# AVELOR AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions: Copy this file to `.env.local` and fill in your API credentials.
# Bun will automatically load `.env.local` without needing flags.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + pgvector Extension via Docker)
# Port 5433 is mapped in docker-compose.yml to avoid host conflict on 5432.
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://avelor:avelor@localhost:5433/avelor_dev

# ------------------------------------------------------------------------------
# 3. AI GUARDRAILS ENGINE (TypeSafe AI Jev Decision Model)
# Used for server-authoritative prompt injection detection, jailbreak protection,
# and customer query containment ($0.042 / million tokens).
# ------------------------------------------------------------------------------
TYPESAFE_API_KEY=

# ------------------------------------------------------------------------------
# 4. CONVERSATIONAL SHOPPING LLM (Google Gemini)
# Used for conversational product discovery, shopper assistance, and tool calls.
# ------------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 5. SEMANTIC VECTOR EMBEDDINGS (OpenAI)
# Used for hybrid semantic product search and knowledge RAG embeddings.
# Model: text-embedding-3-small (1,536 dimensions, $0.02 / million tokens).
# ------------------------------------------------------------------------------
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAY (Cashfree / Mock)
# Options: 'mock' for local dev, 'cashfree' for production checkout.
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
WEBHOOK_SECRET=avelor_dev_secret_key_32chars_long

# ------------------------------------------------------------------------------
# 7. FRONTEND / STOREFRONT CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# ------------------------------------------------------------------------------
# 8. CORS (API server)
# Comma-separated list of browser origins allowed to call the API with cookies.
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000


# Better Auth endpoint on the API server (client hits <root>/api/auth/*)
NEXT_PUBLIC_AUTH_URL=http://localhost:5000
