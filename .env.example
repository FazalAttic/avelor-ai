# Server & Runtime
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL + pgvector on Docker port 5433)
DATABASE_URL=postgres://avelor:avelor@localhost:5433/avelor_dev

# Cache & Ephemeral Storage (Redis 7 on Docker port 6379)
REDIS_URL=redis://localhost:6379

# AI Models & Guardrails
TYPESAFE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=

# Payments
PAYMENT_PROVIDER=mock
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
WEBHOOK_SECRET=avelor_dev_secret_key_32chars_long

# Storefront URLs
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_AUTH_URL=http://localhost:5000
# Tenant whose catalog the storefront chat assistant queries
NEXT_PUBLIC_AVELOR_TENANT_ID=store_alpha

# Better Auth & Security
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=avelor_dev_secret_auth_32_chars_random_string_xyz
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
