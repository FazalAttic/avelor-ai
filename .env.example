# =============================================================================
# AVELOR AI — ARCHITECTURAL ENVIRONMENT CONFIGURATION
# Credentials are organized cleanly by architectural layer rather than vendor names.
# =============================================================================


# 1. Database & Cache Layer

# PostgreSQL connection with pgvector extension (Docker default: port 5433)
DATABASE_URL=postgres://avelor:avelor@localhost:5433/avelor_dev
# Cache & ephemeral store (Redis 7 Docker default: port 6379, falls back to REDIS_URL)
CACHE_URL=redis://localhost:6379


# 2. LLM Layer (Conversational Shopping Assistant & Reasoning)

# LLM provider: 'google' | 'openai' | 'mock'
LLM_PROVIDER=google
# LLM Layer API key (supports Gemini API key or OpenAI API key)
LLM_API_KEY=
# LLM Layer Model ID (e.g. gemini-3.5-flash-lite, gpt-4o-mini)
LLM_MODEL=gemini-3.5-flash-lite


# 3. Embedding Model Layer (Catalog Vector Embeddings & Semantic Discovery)

# Embedding provider: 'openai' | 'google' | 'mock'
EMBEDDING_PROVIDER=openai
# Embedding Layer API key (falls back to LLM_API_KEY if not specified)
EMBEDDING_API_KEY=
# Embedding Model ID (e.g. text-embedding-3-small for OpenAI, text-embedding-004 for Google)
EMBEDDING_MODEL=text-embedding-3-small
# Vector dimension count (1536 for text-embedding-3-small, 768 for text-embedding-004)
EMBEDDING_DIMENSIONS=1536


# 4. AI Guardrail & Safety Layer (Intent Classification & Injection Defense)

# Fast, calibrated System-One classifier API key (falls back to TYPESAFE_API_KEY)
GUARDRAIL_API_KEY=


# 5. Payment Gateway Layer

# Payment provider: 'mock' | 'razorpay' | 'cashfree' | 'stripe'
PAYMENT_PROVIDER=mock
# Payment application / client credentials (e.g. Razorpay Key ID, Cashfree App ID)
PAYMENT_APP_ID=
PAYMENT_SECRET_KEY=
PAYMENT_ENV=sandbox
PAYMENT_CURRENCY=USD
# Webhook verification secret (falls back to WEBHOOK_SECRET)
PAYMENT_WEBHOOK_SECRET=avelor_dev_secret_key_32chars_long


# 6. Transactional Email Layer

# Email provider: 'resend' | 'mock'
EMAIL_PROVIDER=resend
# Email service API key (falls back to RESEND_API_KEY)
EMAIL_API_KEY=
EMAIL_FROM=Avelor <onboarding@resend.dev>
REQUIRE_EMAIL_VERIFICATION=false


# 7. Identity & Authentication Layer (Sessions, Roles, OAuth)

# Session token signature secret (32+ chars, falls back to BETTER_AUTH_SECRET)
AUTH_SECRET=avelor_dev_secret_auth_32_chars_random_string_xyz
# Canonical backend auth URL (falls back to BETTER_AUTH_URL)
AUTH_URL=http://localhost:5000
# OAuth client credentials (falls back to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET)
AUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000


# 8. Media & Image Storage Layer (ImageKit + Cloudflare Edge CDN)

# ImageKit API credentials for product asset uploads
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/mqz7lr6zf
# Cloudflare Worker Edge CDN domain (permanent edge cache & brand title-bar proxy)
IMAGEKIT_CDN_URL=https://cdn.avelor-ai.cyou


# 9. Server & Storefront Runtime

PORT=5000
NODE_ENV=development
LOG_LEVEL=info
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_AUTH_URL=http://localhost:5000
NEXT_PUBLIC_AVELOR_TENANT_ID=store_alpha
