# Avelor AI - Environment Configuration Example
# Copy this file to .env and replace placeholders with actual values.

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgres://avelor:avelor@localhost:5432/avelor_dev

# AI & Guardrail Provider Configuration
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
TYPESAFE_API_KEY=

# Payment Provider Configuration
PAYMENT_PROVIDER=mock

